        { "name": "inc", "type": "multi_line_text_field", "displayName": "What's included", "validations": [] },
        { "name": "banner", "type": "single_line_text_field", "displayName": "Banner pill (blank = auto \"You save\")", "validations": [] },
        { "name": "featured", "type": "boolean", "displayName": "Featured (Most popular flag)", "validations": [] },
        { "name": "price", "type": "number_decimal", "displayName": "Combo price (blank = sum of products)", "validations": [] },
        { "name": "link", "type": "url", "displayName": "Shop bundle link", "validations": [] },
        { "name": "products", "type": "product_reference", "displayName": "Products", "validations": [] }
      ]
    },
    {
      "name": "review",
      "type": "review",
      "displayName": "Review",
