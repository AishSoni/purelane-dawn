      "fieldDefinitions": [
        { "name": "author", "type": "single_line_text_field", "displayName": "Author", "validations": [{ "name": "required" }] },
        { "name": "rating", "type": "number_integer", "displayName": "Rating (1-5)", "validations": [{ "name": "min", "value": "1" }, { "name": "max", "value": "5" }] },
        { "name": "title", "type": "single_line_text_field", "displayName": "Title", "validations": [] },
        { "name": "body", "type": "multi_line_text_field", "displayName": "Body", "validations": [] },
        { "name": "context", "type": "single_line_text_field", "displayName": "Context (e.g. Bought for the kitchen)", "validations": [] },
        { "name": "verified", "type": "boolean", "displayName": "Verified purchase", "validations": [] }
      ]
    }
  ]
}
