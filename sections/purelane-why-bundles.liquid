{%- comment -%}
  Purelane why bundles (#whybundles)
  ----------------------------------
  Four selling points for the bundle model as editable blocks
  (icon + title + note) inside a glass panel.
{%- endcomment -%}

<section
  class="sec"
  id="shopify-section-{{ section.id }}"
  data-pl
  data-scene="4"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="wrap" id="whybundles">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        <h2 class="d2">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="wb">
        {%- for block in section.blocks -%}
          <div class="wb-i" {{ block.shopify_attributes }}>
            <span class="ci">{% render 'pl-icon', icon: block.settings.icon, size: 22 %}</span>
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.body | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane why bundles",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "tag", "label": "Price tag" },
            { "value": "check", "label": "Check" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "truck", "label": "Truck" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Save up to 45%"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "default": "Versus buying the same products separately"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Purelane why bundles",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "tag", "title": "Save up to 45%", "body": "Versus buying the same products separately" } },
        { "type": "benefit", "settings": { "icon": "check", "title": "One flat price", "body": "No calculators, no comparing carts" } },
        { "type": "benefit", "settings": { "icon": "sparkle", "title": "Curated by experts", "body": "Products picked to work well together" } },
        { "type": "benefit", "settings": { "icon": "truck", "title": "Free shipping always", "body": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}