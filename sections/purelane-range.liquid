{%- comment -%}
  Purelane full range (#range)
  ----------------------------
  Auto-scrolling shelf strip built from a collection's featured images.
  No products with images = hidden entirely.
{%- endcomment -%}

{%- liquid
  assign range_collection = section.settings.collection
  assign range_products = range_collection.products | where: 'featured_image'
-%}

<section
  class="sec"
  id="shopify-section-{{ section.id }}"
  data-pl
  data-scene="3"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="wrap" id="range">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker | escape }}</span>
          {%- endif -%}
          <h2 class="d2">{{ section.settings.heading | escape }}</h2>
        </div>
        {%- if section.settings.body != blank -%}
          <p class="body-s">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>
      {%- if range_products.size > 0 -%}
        <div class="stripwrap">
          <div class="rangerow">
            {%- for product in range_products -%}
              <img
                class="pimg"
                src="{{ product.featured_image | image_url: width: 260 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                loading="lazy"
              >
            {%- endfor -%}
          </div>
        </div>
        {%- if section.settings.hint != blank -%}
          <p class="striphint">{{ section.settings.hint | escape }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane full range",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Featured images scroll through the shelf strip."
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Swipe hint",
      "default": "Swipe to see the full shelf"
    }
  ],
  "presets": [
    {
      "name": "Purelane full range"
    }
  ]
}
{% endschema %}