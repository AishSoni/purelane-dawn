{%- comment -%}
  Purelane trust + signup
  -----------------------
  Trust bar (icon + two-line claim per block) followed by the newsletter
  glass ("Join the Purelane Club"). The signup form is the standard
  Shopify customer newsletter form — posts to /contact, no app needed.
{%- endcomment -%}

<section class="sec" id="shopify-section-{{ section.id }}" data-pl data-scene="4" aria-label="Trust and signup">
  <div class="wrap">
    <div class="glass trust rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust' -%}
          <div class="trust-i" {{ block.shopify_attributes }}>
            {% render 'pl-icon', icon: block.settings.icon, size: 20, stroke: 1.5 %}
            <span>{{ block.settings.label | escape | newline_to_br }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="glass signup rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      <h2 class="d2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="lede">{{ section.settings.body | escape }}</p>
      {%- endif -%}
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | escape }}"
          aria-label="{{ section.settings.placeholder | escape }}"
          required
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors %}aria-invalid="true"{% endif %}
        >
        <button class="btn btn-primary" type="submit">{{ section.settings.button_label | escape }}</button>
        {%- if form.posted_successfully? -%}
          <p class="signup-ok" tabindex="-1">{{ section.settings.success | escape }}</p>
        {%- elsif form.errors -%}
          <p class="signup-ok signup-err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane trust + signup",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Sub-line",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my ₹100 off"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Success message",
      "default": "Thanks! Check your inbox for your code."
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust claim",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" },
            { "value": "globe", "label": "Globe" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "leaf"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Claim (one line per row)",
          "default": "Plant derived\nformulas"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Purelane trust + signup",
      "blocks": [
        { "type": "trust", "settings": { "icon": "leaf", "label": "Plant derived\nformulas" } },
        { "type": "trust", "settings": { "icon": "box", "label": "Recyclable\npackaging" } },
        { "type": "trust", "settings": { "icon": "heart", "label": "Safe for\nkids & pets" } },
        { "type": "trust", "settings": { "icon": "globe", "label": "Made in\nIndia" } }
      ]
    }
  ]
}
{% endschema %}