{%- comment -%}
  Purelane proof (#proof)
  -----------------------
  "Why it works": a product rotator built from a collection plus a stats
  row (four editable figures). Supports the product selected from the
  collection, so the rotator is real product imagery, not hardcoded art.
  The rotator is decorative (aria-hidden); captions are driven by
  data-attributes read by purelane.js.
{%- endcomment -%}

{%- liquid
  assign proof_collection = section.settings.collection
-%}

<section
  class="sec"
  id="shopify-section-{{ section.id }}"
  data-pl
  data-scene="3"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker | escape }}</span>
          {%- endif -%}
          <h2 class="d2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.body != blank -%}
            <p class="body-s">{{ section.settings.body | escape }}</p>
          {%- endif -%}
          {%- if section.settings.cta_label != blank -%}
            <a class="btn btn-primary" href="{{ section.settings.cta_link | default: '#' }}">
              {{ section.settings.cta_label | escape }}
              {% render 'pl-icon', icon: 'arrow', size: 15, stroke: 2.2 %}
            </a>
          {%- endif -%}
        </div>

        {%- if proof_collection != blank and proof_collection.products_count > 0 -%}
          {%- liquid
            assign rot_products = proof_collection.products | where: 'featured_image', true
            assign rot_count = rot_products.size

            assign note = 'Best seller'
          -%}
          <div class="glass-2 rot" data-rot aria-hidden="true">
            <div class="frame">
              {%- for product in rot_products limit: 6 -%}
                <img
                  class="pimg{% if forloop.first %} on{% endif %}"
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  data-name="{{ product.title | escape }}"
                  data-note="{{ product.metafields.custom.rotator_note | default: note | escape }}"
                  loading="lazy"
                >
              {%- endfor -%}
            </div>
            <div class="cap"><b></b><span></span></div>
            <div class="dots">
              {%- for product in rot_products limit: 6 -%}
                <i class="{% if forloop.first %}on{% endif %}"></i>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="stats proof-stats">
          {%- for block in section.blocks -%}
            <div class="stat" {{ block.shopify_attributes }}>
              <div class="ring">{{ block.settings.value | escape }}</div>
              <h5>{{ block.settings.label | escape }}</h5>
              <p>{{ block.settings.note | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane proof",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Why it works"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Tough on grime.\nGentle on everything else."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See the ingredient list"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection for the rotator",
      "info": "Featured images rotate in the right-hand frame."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Big number",
          "default": "99.9%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Germ kill"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Tested against germs and bacteria"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Purelane proof",
      "blocks": [
        { "type": "stat", "settings": { "value": "99.9%", "label": "Germ kill", "note": "Tested against germs and bacteria" } },
        { "type": "stat", "settings": { "value": "0%", "label": "Sulphates", "note": "No SLS, chlorine or parabens" } },
        { "type": "stat", "settings": { "value": "100%", "label": "Plant based", "note": "Cleansers derived from plants" } },
        { "type": "stat", "settings": { "value": "4.8", "label": "Rated", "note": "Across 8,000+ verified reviews" } }
      ]
    }
  ]
}
{% endschema %}