{%- comment -%}
  Purelane categories (#categories)
  ---------------------------------
  "Find the right bundle for you" — link tiles with a product image.
  Each block: product picker (for the tile image), title, caption, link.
{%- endcomment -%}

<section
  class="sec"
  id="shopify-section-{{ section.id }}"
  data-pl
  data-scene="4"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="wrap" id="categories">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      <h2 class="d2">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        <a
          class="glass cat rv{% if forloop.index > 1 %} rv-d{{ forloop.index }}{% endif %}"
          href="{{ block.settings.link | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          <span class="ph">
            {%- if block.settings.product != blank and block.settings.product.featured_image != blank -%}
              <img
                class="pimg"
                src="{{ block.settings.product.featured_image | image_url: width: 260 }}"
                alt="{{ block.settings.product.featured_image.alt | default: block.settings.title | escape }}"
                width="{{ block.settings.product.featured_image.width }}"
                height="{{ block.settings.product.featured_image.height }}"
                loading="lazy"
              >
            {%- else -%}
              <span class="pimg pimg--placeholder">{% render 'pl-icon', icon: 'leaf', size: 30 %}</span>
            {%- endif -%}
          </span>
          <span class="txt">
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.caption | escape }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane categories",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (tile image)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Purelane categories",
      "blocks": [
        { "type": "tile", "settings": { "title": "Kitchen bundle", "caption": "Grease, dishes & more" } },
        { "type": "tile", "settings": { "title": "Bathroom bundle", "caption": "Deep clean & disinfect" } },
        { "type": "tile", "settings": { "title": "Laundry bundle", "caption": "Softer, fresher wash" } },
        { "type": "tile", "settings": { "title": "Hard water bundle", "caption": "Melt away limescale" } }
      ]
    }
  ]
}
{% endschema %}