{%- comment -%}
  Purelane product grid (#shop)
  -----------------------------
  Bestsellers shelf. Pulls live products from the chosen collection.
  Each card shows the featured image (or a leaf placeholder), an optional
  badge pill from the product's custom.badge metafield, the title, a star
  row from the native reviews.rating / reviews.rating_count metafields,
  price with compare-at discount, and a real add-to-cart form that POSTs to
  /cart/add (the theme's JS upgrades the submit to /cart/add.js; the plain
  POST is the no-JS fallback).
{%- endcomment -%}

{%- assign pl_collection = section.settings.collection -%}
{%- assign pl_products_to_show = section.settings.products_to_show -%}

<section
  id="shopify-section-{{ section.id }}"
  class="sec"
  data-pl
  data-scene="3"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="rule">
        <i></i>
        {% render 'pl-icon', icon: 'leaf', size: 16 %}
        <i></i>
      </div>
    </div>

    {%- if pl_collection == blank or pl_collection.products_count == 0 -%}
      <div class="glass sec-pad" style="text-align:center">
        <p class="body-s">No products found — pick a collection in the section settings.</p>
      </div>
    {%- else -%}
      <div class="shelf">
        {%- for product in pl_collection.products limit: pl_products_to_show -%}
          {%- liquid
            assign reveal = 'rv'
            assign m = forloop.index0 | modulo: 4
            if m == 1
              assign reveal = 'rv rv-d1'
            elsif m == 2
              assign reveal = 'rv rv-d2'
            elsif m == 3
              assign reveal = 'rv rv-d3'
            endif
          -%}
          <article class="glass pl-card {{ reveal }}">
            <div class="shot">
              {%- if product.metafields.custom.badge.value != blank -%}
                <span class="pill">{{ product.metafields.custom.badge.value | escape }}</span>
              {%- endif -%}
              {%- if product.featured_image != blank -%}
                {%- assign pl_alt = product.featured_image.alt | default: product.title | escape -%}
                <img
                  class="pimg"
                  src="{{ product.featured_image | image_url: width: 500 }}"
                  alt="{{ pl_alt }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <span class="pimg--placeholder" role="img" aria-label="{{ product.title | escape }}">
                  {% render 'pl-icon', icon: 'leaf', size: 34 %}
                </span>
              {%- endif -%}
            </div>

            <h4><a class="pl-card-link" href="{{ product.url }}">{{ product.title | escape }}</a></h4>

            {%- liquid
              assign pl_rating = product.metafields.reviews.rating.value
              assign pl_rating_count = product.metafields.reviews.rating_count.value
            -%}
            {%- if section.settings.show_rating and pl_rating != blank -%}
              <div class="rate" title="{{ pl_rating | escape }} out of 5">
                <b>★ {{ pl_rating }}</b>
                {%- if pl_rating_count != blank -%} · {{ pl_rating_count }} reviews{%- endif -%}
              </div>
            {%- endif -%}

            {%- liquid
              assign v = product.first_available_variant
              unless v
                assign v = product.variants.first
              endunless
            -%}
            <div class="pr">
              {%- if v -%}
                <strong>{{ v.price | money }}</strong>
                {%- if v.compare_at_price and v.compare_at_price > v.price -%}
                  {%- assign pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | round -%}
                  <s>{{ v.compare_at_price | money }}</s>
                  <em>{{ pct }}% off</em>
                {%- endif -%}
              {%- endif -%}
            </div>

            {%- if v -%}
              <form method="post" action="{{ routes.cart_add_url }}" class="pl-add">
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn btn-ghost btn-sm" {% unless product.available %}disabled{% endunless %}>
                  {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                </button>
              </form>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane product grid",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show ratings",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Star ratings come from the native reviews.rating / reviews.rating_count product metafields; cards without a rating skip the row entirely. The badge pill comes from the product metafield custom.badge."
    }
  ],
  "presets": [
    {
      "name": "Purelane product grid"
    }
  ]
}
{% endschema %}