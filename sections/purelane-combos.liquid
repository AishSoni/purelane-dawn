{%- comment -%}
  Purelane combos (#combos)
  --------------------------------------
  Snap-scroll rail of pre-built combo cards. Each combo comes from the
  "combo" metaobject (name, tagline, inc, banner, featured, price, link,
  products). Prices are derived from each included product's first
  available variant at render time, so mrp/sale stays accurate without
  hardcoding any product or price in the theme.
{%- endcomment -%}

{%- liquid
  assign combos = shop.metaobjects.combo.values
  assign combos_count = combos | size
-%}

<section
  class="sec"
  id="shopify-section-{{ section.id }}"
  data-pl
  data-scene="3"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule"><i></i>{% render 'pl-icon', icon: 'leaf', size: 16 %}<i></i></div>
      {%- if section.settings.lede != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
    </div>

    {%- if combos_count > 0 -%}
      <div class="comborail rv">
        {%- for combo in combos -%}
          {%- liquid
            assign prod_count = combo.products.value | size
            assign mrp_total = 0
            assign price_total = 0
            for item in combo.products.value
              assign p = item.product
              if p == blank
                continue
              endif
              assign v = p.first_available_variant
              unless v
                assign v = p.variants.first
              endunless
              if v == blank
                continue
              endif
              assign mrp = v.compare_at_price
              if mrp == blank or mrp <= v.price
                assign mrp = v.price
              endif
              assign mrp_total = mrp_total | plus: mrp
              assign price_total = price_total | plus: v.price
            endfor

            if combo.price.value == blank
              assign combo_cents = mrp_total
            else
              assign combo_cents = combo.price.value | times: 100 | round
            endif
            assign raw_save = mrp_total | minus: combo_cents
            if raw_save < 0
              assign raw_save = 0
            endif

            assign save_pill = combo.banner.value
            if save_pill == blank
              assign save_money = raw_save | money
              assign save_pill = "You save " | append: save_money
            endif
            assign save_label = combo.banner.value
            if save_label == blank
              assign save_amount = raw_save | money_without_trailing_zeros
              assign save_label = "Save " | append: save_amount
            endif
          -%}

          <article class="glass combo{% if combo.featured.value %} hero-combo{% endif %}">
            <div class="tray">
              <span class="save">{{ save_pill | escape }}</span>
              {%- if combo.featured.value -%}
                <span class="flag">Most popular</span>
              {%- endif -%}
              <div class="stack">
                {%- for item in combo.products.value -%}
                  {%- if forloop.index > 3 -%}{%- break -%}{%- endif -%}
                  {%- unless forloop.first -%}<span class="plus" aria-hidden="true">+</span>{%- endunless -%}
                  {%- assign p = item.product -%}
                  <span class="it">
                    {%- if p != blank -%}
                      {%- if p.featured_image != blank -%}
                        <img class="pimg" src="{{ p.featured_image | image_url: width: 200 }}" alt="{{ p.title | escape }}" width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}" loading="lazy">
                      {%- else -%}
                        <span class="tile">{% render 'pl-icon', icon: 'leaf', size: 17 %}</span>
                      {%- endif -%}
                      <span>{{ p.title | escape }}</span>
                    {%- else -%}
                      {%- if item.featured_image != blank -%}
                        <img class="pimg" src="{{ item.featured_image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="{{ item.featured_image.width }}" height="{{ item.featured_image.height }}" loading="lazy">
                      {%- else -%}
                        <span class="tile">{% render 'pl-icon', icon: 'leaf', size: 17 %}</span>
                      {%- endif -%}
                      <span>{{ item.title | default: 'Purelane product' | escape }}</span>
                    {%- endif -%}
                  </span>
                {%- endfor -%}
              </div>
            </div>
            <div class="body">
              <h3>{{ combo.name.value | escape }}</h3>
              <div class="cnt">{{ prod_count }} products</div>
              {%- if combo.inc.value != blank -%}
                <p class="inc">{{ combo.inc.value | escape }}</p>
              {%- endif -%}
              <div class="prow">
                <strong>{{ combo_cents | money }}</strong>
                {%- if mrp_total > combo_cents -%}
                  <s>{{ mrp_total | money }}</s>
                {%- endif -%}
                <em>{{ save_label | escape }}</em>
              </div>
              <div class="fine">Inclusive of all taxes &middot; COD available</div>
              <a class="btn btn-ghost" href="{{ combo.link.value | default: '#' }}">Shop bundle{% render 'pl-icon', icon: 'arrow', size: 14, stroke: 2.2 %}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="swipecue" aria-hidden="true">{% render 'pl-icon', icon: 'arrow', size: 14, stroke: 2.2 %}{{ section.settings.swipe_label | escape }}</div>
      {%- if section.settings.railnote != blank -%}
        <p class="railnote">{{ section.settings.railnote | escape }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Leading description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "text",
      "id": "swipe_label",
      "label": "Swipe cue label",
      "default": "Swipe for more combos"
    },
    {
      "type": "textarea",
      "id": "railnote",
      "label": "Note under the rail",
      "default": "Tapping \"Shop bundle\" opens the picker with these products already added. You can still swap anything before you pay."
    },
    {
      "type": "paragraph",
      "content": "Add combos in Settings > Custom data (metaobject type: combo). Fields: name, tagline, inc, banner, featured, price, link, products."
    }
  ],
  "presets": [
    {
      "name": "Purelane combos"
    }
  ]
}
{% endschema %}